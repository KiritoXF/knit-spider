{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpiderKnit",
  "version": "0.2.5",
  "identifier": "com.spiderknitchart.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "蜘蛛织毛线",
        "url": "knitting-chart.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KiritoXF/knit-spider/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQ0E1MTA4NUE0QkRFRUMKUldUczNrdGFDRkhLb0svMm9JOEJ6K0hiL1dLLzZ3RiszYm1veWNiMk5qZ2w1RmhvRjI0bUg5cVkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
