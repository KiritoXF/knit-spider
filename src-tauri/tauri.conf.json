{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpiderKnit",
  "version": "0.2.10",
  "identifier": "com.spiderknitchart.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/tauri-before-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "蜘蛛织毛线",
        "url": "knitting-chart.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
